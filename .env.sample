# Copy to .env in the kit root (~/adw/.env). The current repo's .env, if any, overrides these.

# Leave empty if Claude Code is already logged in on this machine (it then uses that login).
ANTHROPIC_API_KEY=

# Default model for every command: sonnet or opus. --model overrides per run.
ADW_MODEL=sonnet

# Which CLI runs the agent. Only "claude" is implemented today.
ADW_RUNNER=claude

# Path to the Claude Code binary, if `claude` is not on PATH (`which claude`).
CLAUDE_CODE_PATH=claude
